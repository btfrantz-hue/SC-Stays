# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o arquivo .env

# Supabase — cliente público (exposto no bundle do browser)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Supabase — service role (NUNCA use prefixo VITE_ aqui)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Admin — login em /admin/login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Chave usada para assinar/criptografar o cookie de sessão do admin (min. 32 chars aleatórios)
ADMIN_SESSION_SECRET=

# Google Analytics (opcional)
VITE_GA_ID=G-XXXXXXXXXX
